# Ignore cryptography files
service/app_certs/*
!service/app_certs/.gitkeep
!service/app_certs/README.md

/host_certs/*
!host_certs/.gitkeep
!host_certs/README.md

# Certificados de homologacion, guardados aparte al pasar a produccion
# (2026-08-24). Contiene PrivateKey.key: NO se sube, este repo es publico.
/host_certs_homologacion/

# Ignore venv
/venv

# Ignore .env
.env

# Ignore cache files
__pycache__/
*.pyc
*.pyo
*.pyd
*pytest_cache

# Ignore critical XML files
*host_xml/*
!host_xml/.gitkeep
!host_xml/README.md

*src/shared/app_xml_files
!src/shared/app_xml_files/.gitkeep
!src/shared/app_xml_files/README.md

# Ignore .coverage file
.coverage